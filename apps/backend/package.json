{
  "name": "@mlab/backend",
  "version": "1.14.2",
  "private": true,
  "scripts": {
    "build": "go build -o ./bin/server.exe ./cmd/server",
    "dev": "go run ./cmd/server/main.go",
    "test": "go test ./...",
    "test:load": "go test -tags loadtest -run TestLoad_SFUFanout -v -count=1 -timeout 10m ./internal/webrtc/",
    "test:smoke": "go test -tags smoke -run TestSmoke -v -count=1 -timeout 5m ./cmd/server/",
    "lint": "go vet ./...",
    "clean": "node -e \"require('fs').rmSync('bin', { recursive: true, force: true })\""
  }
}
