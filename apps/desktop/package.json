{
  "name": "@mlab/desktop",
  "version": "1.3.9",
  "description": "MLab - App Desktop do Professor",
  "author": "MLab",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:web": "npm --prefix ../web run build",
    "build:backend": "go build -C ../backend -o ./bin/server.exe ./cmd/server",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "premake": "npm version patch --no-git-tag-version",
    "make": "npm run build:web && npm run build:backend && npm run build && electron-builder",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf out dist"
  },
  "dependencies": {
    "@mlab/types": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "com.mlab.classroom",
    "productName": "MLab",
    "electronVersion": "31.7.7",
    "copyright": "Copyright © 2024 MLab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/bin/server.exe",
        "to": "bin/server.exe"
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "MLab Team",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MLab",
      "uninstallDisplayName": "MLab",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "resources/icon.png"
    }
  }
}
