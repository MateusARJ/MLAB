{
  "name": "mlab",
  "version": "2.2.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MateusARJ/MLAB.git"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bump": "node ./scripts/bump-version.mjs",
    "version:check": "node ./scripts/bump-version.mjs --check",
    "spec:check": "node ./scripts/spec-check.js",
    "smoke": "node ./scripts/smoke-report.js",
    "build": "turbo run build",
    "dev": "node ./scripts/dev.js",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "make": "npm --prefix apps/desktop run make",
    "make:win": "npm --prefix apps/desktop run make:win",
    "make:linux": "npm --prefix apps/desktop run make:linux",
    "make:linux:appimage": "npm --prefix apps/desktop run make:linux:appimage",
    "make:linux:deb": "npm --prefix apps/desktop run make:linux:deb",
    "make:mac": "npm --prefix apps/desktop run make:mac",
    "make:all": "npm --prefix apps/desktop run make"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
